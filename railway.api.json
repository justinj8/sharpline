{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["src/**", "apps/api/**", "db/**", "pyproject.toml", "uv.lock", "railpack.json", "alembic.ini", "railway.api.json"]
  },
  "deploy": {
    "preDeployCommand": [".venv/bin/alembic upgrade head"],
    "startCommand": "sh -c '.venv/bin/uvicorn sharpline_api.app:create_app --factory --host 0.0.0.0 --port ${PORT:-8000}'",
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
