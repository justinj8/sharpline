{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["src/**", "apps/worker/**", "db/**", "pyproject.toml", "uv.lock", "railpack.json", "railway.worker.json"]
  },
  "deploy": {
    "startCommand": ".venv/bin/python -m sharpline_worker",
    "restartPolicyType": "ALWAYS"
  }
}
