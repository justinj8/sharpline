# Copy to .env and fill in. Never commit .env.

# Railway dev environment Postgres: copy the service's DATABASE_PUBLIC_URL.
DATABASE_URL=
# Same server and admin user; tests create and drop sharpline_test_* databases on it.
TEST_DATABASE_URL=

SHARPLINE_ENV=local
LOG_LEVEL=INFO

# Optional until later phases.
ANTHROPIC_API_KEY=
ODDS_API_KEY=

# Slate bundle bucket: copy these from the Railway bucket's credentials tab.
# Leave BUNDLE_BUCKET empty to use the local store at var/bundles.
BUNDLE_BUCKET=
BUNDLE_ENDPOINT_URL=
BUNDLE_ACCESS_KEY_ID=
BUNDLE_SECRET_ACCESS_KEY=
BUNDLE_REGION=auto
